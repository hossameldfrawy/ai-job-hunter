# LOCAL SECRETS - gitignored, never commit. Cloud uses GitHub/Render secrets.
GEMINI_API_KEY=your-gemini-api-key
CALLMEBOT_APIKEY=your-callmebot-apikey
WHATSAPP_PHONE=+201234567890
CV_PATH=assets/master_cv.pdf
LOG_LEVEL=INFO
DRY_RUN=false

# --- Optional -------------------------------------------------------------
# Cloud-friendly CV delivery (avoids committing the PDF to the repo):
# CV_TEXT=paste-your-plain-text-cv-here
# MASTER_CV_B64=base64-of-your-pdf

# --- Telegram MTProto user client -----------------------------------------
# Unlocks your PRIVATE groups, supergroups and join-restricted channels.
# Public channels do NOT need any of this (see telegram_web.py).
#   1. Get api_id/api_hash: https://my.telegram.org -> API development tools
#   2. Run once: python auth_telegram.py
#   3. It writes TELEGRAM_STRING_SESSION here and to secrets/
# The string session is a FULL LOGIN to your account. Never commit it.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+201234567890
# TELEGRAM_STRING_SESSION=

# Facebook page reading with your own cookie (opt-in):
# FACEBOOK_COOKIE=c_user=...; xs=...

# Emergency overrides:
# MATCH_THRESHOLD=75
# MAX_ALERTS_PER_RUN=12
# DISABLE_LINKEDIN=1
